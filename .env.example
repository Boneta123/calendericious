# Copy to .env and fill in. Never commit .env.
# Loaded by `npm run server` via node --env-file=.env

# Postgres connection string (required)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/calendericious

# Secret for the /admin dashboard (required to use /admin)
ADMIN_KEY=

# Google Places API (New) key, used server-side for address -> business lookup
GOOGLE_MAPS_API_KEY=

# Resend, used for password-reset emails
RESEND_API_KEY=
RESEND_FROM="Calendericious <noreply@example.com>"

# Optional
# PORT=4000
# CORS_ORIGINS=https://example.com,https://admin.example.com

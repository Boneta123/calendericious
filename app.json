{
  "expo": {
    "name": "DealDay",
    "slug": "dealCalenderRoot",
    "scheme": "dealday",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./frontend/assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#FFF6EC"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.dealCalenderRoot"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF6EC",
        "foregroundImage": "./frontend/assets/android-icon-foreground.png",
        "backgroundImage": "./frontend/assets/android-icon-background.png",
        "monochromeImage": "./frontend/assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./frontend/assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./frontend/app"
        }
      ],
      "expo-font",
      "expo-splash-screen",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Calendericious to access your photos so you can set a profile picture."
        }
      ]
    ]
  }
}
